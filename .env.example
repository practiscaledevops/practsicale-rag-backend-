# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Region ----
# Supabase project region: ap-southeast-1 (Singapore). Pin Vercel functions to sin1.
SUPABASE_REGION=ap-southeast-1
VERCEL_FUNCTION_REGION=sin1

# ---- Model providers ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional: route generation through the Vercel AI Gateway for provider failover.
AI_GATEWAY_API_KEY=

# ---- Reranking (optional but recommended) ----
COHERE_API_KEY=

# ---- Link capture (optional) ----
# Exa web-contents API: YouTube transcripts from Vercel (bot-walled IPs), social
# posts, blocked / JS-only pages. Prefer storing it encrypted in the DB instead:
# `npm run set:provider-key -- exa` (or Settings -> Provider API keys).
EXA_API_KEY=

# ---- Cache and background jobs (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- App config ----
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024

# Model tiers (selectable in the UI; RECOMMENDED_CHAT_MODEL is the default).
FAST_CHAT_MODEL=claude-haiku-4-5
RECOMMENDED_CHAT_MODEL=claude-sonnet-4-6
MAX_CHAT_MODEL=claude-opus-4-8

# Secret used to sign/verify admin sessions and hash API keys (generate a long random value).
APP_SECRET=change-me-to-a-long-random-string

# ---- Call-scoring pull connector (data source auth) ----
# The scoring API key is referenced by the data_source's auth_secret_ref = "SCORING_API_KEY".
SCORING_API_KEY=
SCORING_ENDPOINT=https://scoring.practicescalingsystems.com/api/public/reports
# Business time zone (IANA id) for call dates when a request names no user zone.
# Chat / compact / jobs callers send the user's own `timeZone`, which wins, so
# "today's calls" is the asking user's calendar day. Default: Asia/Karachi.
# Legacy SCORING_TZ_OFFSET_MIN (minutes east of UTC, e.g. 300) is honoured only
# when SCORING_TIME_ZONE is unset or invalid; prefer the IANA id (DST-aware).
# SCORING_TIME_ZONE=Asia/Karachi

# ---- One-time live bootstrap (npm run setup:live) ----
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=
SETUP_ORG_NAME=Practiscale
# Set to 1 to run a first backfill sync during setup.
SETUP_INITIAL_SYNC=0
SETUP_SYNC_LIMIT=500

# Cron endpoint secret (/api/cron/sync, /api/cron/jobs). Set the same value in Vercel project env.
CRON_SECRET=

# ---- Background jobs ----
# How many audit batches run at once per drainer (Vercel cron / request kick /
# Trigger.dev worker). Higher = faster + more model calls in flight (watch your
# provider rate limits). Default 5.
JOB_CONCURRENCY=5
# Model tier for per-batch call audits: max (Opus, default) | recommended (Sonnet,
# ~4-5x cheaper + faster) | fast. Sonnet is usually plenty for this pass.
AUDIT_MODEL_TIER=max

# ---- Background jobs on Trigger.dev (optional; see docs/JOBS.md) ----
# When TRIGGER_SECRET_KEY is set, heavy audits run on Trigger.dev's machines
# (no timeout, parallel agents). Unset, jobs run on the Vercel cron drainer.
# Server key from the Trigger.dev dashboard (API keys) — set in Vercel env only.
TRIGGER_SECRET_KEY=
# Project ref (Trigger.dev → Settings → General), used by trigger.config.ts / CLI.
TRIGGER_PROJECT_REF=
