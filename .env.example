# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Region ----
# Supabase project region: ap-southeast-1 (Singapore). Pin Vercel functions to sin1.
SUPABASE_REGION=ap-southeast-1
VERCEL_FUNCTION_REGION=sin1

# ---- Model providers ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional: route generation through the Vercel AI Gateway for provider failover.
AI_GATEWAY_API_KEY=

# ---- Reranking (optional but recommended) ----
COHERE_API_KEY=

# ---- Cache and background jobs (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- App config ----
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024

# Model tiers (selectable in the UI; RECOMMENDED_CHAT_MODEL is the default).
FAST_CHAT_MODEL=claude-haiku-4-5
RECOMMENDED_CHAT_MODEL=claude-sonnet-4-6
MAX_CHAT_MODEL=claude-opus-4-8

# Secret used to sign/verify admin sessions and hash API keys (generate a long random value).
APP_SECRET=change-me-to-a-long-random-string

# ---- Call-scoring pull connector (data source auth) ----
# The scoring API key is referenced by the data_source's auth_secret_ref = "SCORING_API_KEY".
SCORING_API_KEY=
SCORING_ENDPOINT=https://scoring.practicescalingsystems.com/api/public/reports

# ---- One-time live bootstrap (npm run setup:live) ----
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=
SETUP_ORG_NAME=Practiscale
# Set to 1 to run a first backfill sync during setup.
SETUP_INITIAL_SYNC=0
SETUP_SYNC_LIMIT=500

# Cron endpoint secret (/api/cron/sync). Set the same value in Vercel project env.
CRON_SECRET=
