# DEMO MODE template — copy to .env.local to run the Brain with NO Supabase and
# NO API keys (in-memory fixtures + canned AI stream). For a real deployment,
# use .env.example instead.
#   cp .env.demo .env.local && npm run dev
DEMO_MODE=1
NEXT_PUBLIC_DEMO_MODE=1

# Harmless placeholders so module-level client construction never throws.
NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key
OPENAI_API_KEY=demo
ANTHROPIC_API_KEY=demo
APP_SECRET=demo-app-secret
INGEST_SECRET=demo-ingest-secret

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
FAST_CHAT_MODEL=claude-haiku-4-5
RECOMMENDED_CHAT_MODEL=claude-sonnet-4-6
MAX_CHAT_MODEL=claude-opus-4-8
